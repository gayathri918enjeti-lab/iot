#define BLYNK_TEMPLATE_ID "YOUR_TEMPLATE_ID"
#define BLYNK_TEMPLATE_NAME "IoT Energy Meter"
#define BLYNK_AUTH_TOKEN "YOUR_BLYNK_TOKEN"

#include <WiFi.h>
#include <BlynkSimpleEsp32.h>
#include <PZEM004Tv30.h>

char ssid[] = "YOUR_WIFI_NAME";
char pass[] = "YOUR_WIFI_PASSWORD";

// PZEM RX = GPIO16, TX = GPIO17
PZEM004Tv30 pzem(Serial2, 16, 17);

BlynkTimer timer;

void readEnergyMeter()
{
  float voltage   = pzem.voltage();
  float current   = pzem.current();
  float power     = pzem.power();
  float energy    = pzem.energy();
  float frequency = pzem.frequency();
  float pf        = pzem.pf();

  // Check for invalid readings
  if (isnan(voltage)) {
    Serial.println("Error reading PZEM!");
    return;
  }

  // Send data to Blynk
  Blynk.virtualWrite(V0, voltage);
  Blynk.virtualWrite(V1, current);
  Blynk.virtualWrite(V2, power);
  Blynk.virtualWrite(V3, energy);
  Blynk.virtualWrite(V4, frequency);
  Blynk.virtualWrite(V5, pf);

  // Display on Serial Monitor
  Serial.println("========== ENERGY METER ==========");

  Serial.print("Voltage    : ");
  Serial.print(voltage);
  Serial.println(" V");

  Serial.print("Current    : ");
  Serial.print(current);
  Serial.println(" A");

  Serial.print("Power      : ");
  Serial.print(power);
  Serial.println(" W");

  Serial.print("Energy     : ");
  Serial.print(energy);
  Serial.println(" kWh");

  Serial.print("Frequency  : ");
  Serial.print(frequency);
  Serial.println(" Hz");

  Serial.print("Power Factor: ");
  Serial.println(pf);

  Serial.println("==================================");
}

void setup()
{
  Serial.begin(115200);

  // Start communication with PZEM
  Serial2.begin(9600, SERIAL_8N1, 16, 17);

  // Connect to Wi-Fi and Blynk
  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);

  // Read meter every 2 seconds
  timer.setInterval(2000L, readEnergyMeter);
}

void loop()
{
  Blynk.run();
  timer.run();
}
